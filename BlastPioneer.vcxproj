  <!-- ============================================================
       构建后把"内容资源"同步到运行目录

       为什么需要它：工程目录里的 Assets/Data 是给编译与阅读用的，
       而真正跑起来读的是 exe 旁边那一份（x64\<Config>\Assets 与 \Data）。
       以前靠手工复制，于是经常出现"改了 JSON 但运行时还是旧值"。

       两条硬规则：
         1. 绝不覆盖用户数据：Data\playerData.json（存档）、Data\settings.ini（设置）
            与 Data\launch_state.json（崩溃保护的启动记录）写在 Exclude 里，
            构建永远不会碰它们 —— 否则源码树里的一份旧记录会被复制进运行目录，污染崩溃判定。
         2. SkipUnchangedFiles：只复制时间戳或大小变了的文件，构建不会变慢。
       ============================================================ -->
  <Target Name="CopyContentToOutDir" AfterTargets="Build">
    <ItemGroup>
      <ContentAssetFiles Include="$(MSBuildProjectDirectory)\content\Assets\**\*.*" />
      <ContentDataFiles Include="$(MSBuildProjectDirectory)\content\Data\**\*.*"
                        Exclude="$(MSBuildProjectDirectory)\content\Data\playerData.json;$(MSBuildProjectDirectory)\content\Data\settings.ini;$(MSBuildProjectDirectory)\content\Data\launch_state.json" />
      <ContentModFiles Include="$(MSBuildProjectDirectory)\content\mods\**\*.*" />
      <!-- ui\ 的内容在 content\ui\（tokens.json + 两套 qss），源码在 src\ui\。
           以前这里指向 src\ui，结果改完 qss 构建不会同步，运行目录一直是旧的。 -->
      <ContentUiFiles Include="$(MSBuildProjectDirectory)\content\ui\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ContentAssetFiles)"
          DestinationFiles="@(ContentAssetFiles->'$(OutDir)Assets\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ContentDataFiles)"
          DestinationFiles="@(ContentDataFiles->'$(OutDir)Data\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <!-- 仓库里带的示例模组也同步过去；它们是默认禁用的，不会改变默认玩法 -->
    <Copy SourceFiles="@(ContentModFiles)"
          DestinationFiles="@(ContentModFiles->'$(OutDir)mods\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <!-- 界面样式表：改配色就是改这些 .qss 文本，不需要重新编译；
         同步到运行目录之后程序读的是那一份（想立刻试效果，直接改运行目录那份再重启即可） -->
    <Copy SourceFiles="@(ContentUiFiles)"
          DestinationFiles="@(ContentUiFiles->'$(OutDir)ui\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Message Importance="High" Text="内容资源已同步: $(OutDir)（Assets + Data + mods + ui；用户存档与设置不动）" />
  </Target>
</Project>
